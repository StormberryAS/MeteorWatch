# GitHub's language bar counts what people write, not what a tool generates or what was copied in
# from elsewhere. The files below are one or the other, so they are marked and left out of the
# statistics (and the diffs of generated files are collapsed by default on GitHub).
#
# app.js is compiled from ts/app.ts by tools/build-ts.sh (5 November 2026); edit the TypeScript.
/app.js linguist-generated=true
# peaks.js is compiled from ts/peaks.ts, which tools/gen-peaks.py writes (11 November 2026); change the generator.
/peaks.js linguist-generated=true
/ts/peaks.ts linguist-generated=true
# suncalc.js is SunCalc 1.8.0 (BSD-2-Clause, mourner/suncalc), vendored and kept byte for byte.
/suncalc.js linguist-vendored=true
# visibility.js is compiled from ts/visibility.ts by tools/build-ts.sh (11 November 2026); edit the TypeScript.
/visibility.js linguist-generated=true
# cities.js is the shared Labs city catalogue, written by SunApp's update_cities.py into every app
# repository in its APPS list in one run; copied byte for byte, never edited here.
/cities.js linguist-generated=true
# The search vectors, captured from the MoonApp 90d11dd page by MoonApp's tests/capture-search.ts
# and copied byte for byte; tests/search.test.ts replays them against this page.
/tests/search-vectors.json linguist-generated=true
# The visibility vectors, extracted once from the Skyfield oracle (DE440s) of the research task of
# 11 November 2026; tests/visibility.test.ts replays them against ts/visibility.ts.
/tests/visibility-vectors.json linguist-generated=true
# The edge cells of the same oracle, near the limits of the rule; replayed by the same test.
/tests/visibility-edge-vectors.json linguist-generated=true
